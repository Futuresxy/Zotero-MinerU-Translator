pref-title = MineruDS Translator Settings
pref-hero-subtitle = Extract paper body text with MinerU, translate long PDFs chunk by chunk with DeepSeek or any OpenAI-compatible endpoint, then save everything back into a Zotero child note.
pref-hero-chip = PDF -> MinerU -> LLM -> Note
pref-translation-enabled =
    .label = Enable PDF translation workflow
pref-mineru-group = MinerU Parsing
pref-mineru-desc = Configure PDF extraction, page ranges, and parsing behavior. Tables, images, and reference sections can be filtered before translation.
pref-mineru-base-url = MinerU base URL
pref-mineru-api-token = MinerU API token
pref-mineru-model-version = MinerU model version
pref-mineru-language = Parsing language
pref-mineru-page-ranges = Page ranges
pref-mineru-poll-interval = Poll interval (ms)
pref-mineru-timeout = Timeout (sec)
pref-mineru-enable-table =
    .label = Ask MinerU to detect tables
pref-mineru-enable-formula =
    .label = Ask MinerU to detect formulas
pref-mineru-enable-ocr =
    .label = Enable OCR
pref-llm-group = LLM Translation
pref-llm-desc = Configure the chunked translation model. Long papers are split into Markdown chunks, translated incrementally, and written back into the same Zotero note while running.
pref-provider = Provider
pref-base-url = Base URL
pref-api-key = API key
pref-model = Model
pref-profile-name = Profile name
pref-saved-profiles = Saved profiles
pref-profile-save = Save current profile
pref-profile-load = Load selected profile
pref-profile-delete = Delete selected profile
pref-target-language = Target language
pref-temperature = Temperature
pref-chunk-size = Max chunk characters
pref-concurrency = Translation concurrency
pref-system-prompt = System prompt
pref-output-group = Output
pref-output-desc = Control which sections are translated, whether the original MinerU Markdown is attached, and how the final note is titled. The progress window now stays open until you close it.
pref-skip-images =
    .label = Skip images
pref-skip-tables =
    .label = Skip tables
pref-skip-algorithms =
    .label = Skip algorithm pseudocode, details blocks, and figure/table wrappers
pref-skip-front-matter =
    .label = Skip title/authors/affiliations before abstract or first section
pref-skip-references =
    .label = Stop at references / bibliography
pref-include-original =
    .label = Store original Markdown in note
pref-note-heading = Note heading
pref-help = { $name } Build { $version } { $time }
