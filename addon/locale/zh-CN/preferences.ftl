pref-title = MineruDS Translator 设置
pref-hero-subtitle = 使用 MinerU 识别论文正文，再把长文按分段交给 DeepSeek/OpenAI 兼容接口做详细翻译，最后写回 Zotero 子笔记。
pref-hero-chip = PDF -> MinerU -> LLM -> Note
pref-translation-enabled =
    .label = 启用 PDF 翻译流程
pref-mineru-group = MinerU 解析
pref-mineru-desc = 配置 PDF 识别接口、页码范围和解析行为。表格、图片、参考文献会在翻译阶段按规则过滤。
pref-mineru-base-url = MinerU 地址
pref-mineru-api-token = MinerU API Token
pref-mineru-model-version = MinerU 模型版本
pref-mineru-language = 解析语言
pref-mineru-page-ranges = 页码范围
pref-mineru-poll-interval = 轮询间隔（毫秒）
pref-mineru-timeout = 超时时间（秒）
pref-mineru-enable-table =
    .label = 请求 MinerU 识别表格
pref-mineru-enable-formula =
    .label = 请求 MinerU 识别公式
pref-mineru-enable-ocr =
    .label = 开启 OCR
pref-llm-group = 大模型翻译
pref-llm-desc = 配置分段翻译模型。插件会把长论文切成多个 Markdown 分段，逐段翻译并实时写回同一个 Zotero 笔记。
pref-provider = 服务商
pref-base-url = Base URL
pref-api-key = API Key
pref-model = 模型名
pref-profile-name = 配置名称
pref-saved-profiles = 已保存配置
pref-profile-save = 保存当前配置
pref-profile-load = 载入所选配置
pref-profile-delete = 删除所选配置
pref-target-language = 目标语言
pref-temperature = Temperature
pref-chunk-size = 最大分段字符数
pref-concurrency = 翻译并发请求数
pref-system-prompt = 系统提示词
pref-output-group = 输出控制
pref-output-desc = 控制哪些内容参与翻译、是否附带原始 Markdown，以及最终笔记标题。进度窗默认常驻，完成后由你手动关闭。
pref-skip-images =
    .label = 跳过图片
pref-skip-tables =
    .label = 跳过表格
pref-skip-algorithms =
    .label = 跳过算法伪代码、details 展开块和图表包装块
pref-skip-front-matter =
    .label = 跳过摘要/第一章之前的标题、作者、单位等前置信息
pref-skip-references =
    .label = 在参考文献处停止翻译
pref-include-original =
    .label = 在笔记中附带原始 Markdown
pref-note-heading = 笔记标题前缀
pref-help = { $name } Build { $version } { $time }
