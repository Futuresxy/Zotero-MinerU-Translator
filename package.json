{
  "name": "mineruds-translator",
  "type": "module",
  "version": "0.1.1",
  "description": "Zotero 7 plugin for extracting PDF papers with MinerU and saving chunked LLM translations to Zotero notes.",
  "config": {
    "addonName": "MineruDS Translator",
    "addonID": "mineruds-translator@songxy.dev",
    "addonRef": "minerudstranslator",
    "addonInstance": "MineruDSTranslator",
    "prefsPrefix": "extensions.zotero.minerudstranslator"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Futuresxy/Zotero-MinerU-Translator.git"
  },
  "author": "songxy",
  "bugs": {
    "url": "https://github.com/Futuresxy/Zotero-MinerU-Translator/issues"
  },
  "homepage": "https://github.com/Futuresxy/Zotero-MinerU-Translator#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "batch:translate": "node scripts/batch-translate-pdf.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.6",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
